// This research fixture preserves the material's aggregate/counter/normal-helper sequence.
// See README.md for its independent oracle and the limits of the backend comparison.
#ifdef SLANG_REPRO_UNMASKED_INDICES
#define SLANG_REPRO_GRAPH_INDEX(index) (index)
#else
#define SLANG_REPRO_GRAPH_INDEX(index) ((index) & 0x7fffffffu)
#endif

struct Payload
{
    float3 absorption;
};
struct Stack
{
    float3 layers[1];
    float3 normals[2];
    Payload payload;
};
// Preserve the original branch while passing only the values the helper reads.
float3 adjust(uint hints, float3 direction, float3 normal)
{
    if (hints == 0)
        return normal;
    return normal + direction;
}
struct Graph
{
    uint hints;
    float3 direction;
    uint next;
    uint nextLayer;
    Stack stack;
    [mutating]
    void prepare(uint index, float3 normal)
    {
        stack.normals[index] = adjust(hints, direction, normal);
    }

    [mutating]
    void layer()
    {
        uint index = nextLayer++;
        stack.layers[SLANG_REPRO_GRAPH_INDEX(index)] = float3(1);
    }
    // Write two normals and one layer using the counters initialized by makeGraph.
    // The two indices are 0 and 1: the mask models the material's closure-kind decoding,
    // not an array bounds check. The separate layer counter produces index 0.
    [mutating]
    void populate(float absorption)
    {
        uint index = next++;
        stack.payload.absorption = float3(absorption);
        prepare(SLANG_REPRO_GRAPH_INDEX(index), float3(0, 0, 1));
        index = next++;
        prepare(SLANG_REPRO_GRAPH_INDEX(index), float3(0, 0, 1));
        layer();
    }
};
Graph makeGraph(float3 direction, float absorption)
{
    Graph graph = {};
    graph.direction = direction;
    graph.populate(absorption);
    return graph;
}
StructuredBuffer<uint> inputs;
RWStructuredBuffer<uint> outputs;
#ifndef SLANG_REPRO_CONTROL
[numthreads(1, 1, 1)]
void computeMain()
{
    Graph graph = makeGraph(float3(inputs[0], inputs[1], inputs[2]), 0);
    outputs[0] = uint(dot(exp2(-graph.stack.payload.absorption), float3(8)));
    outputs[1] = uint(graph.stack.normals[0].z);
    outputs[2] = uint(graph.stack.normals[1].z);
    outputs[3] = uint(graph.stack.layers[0].x);
}

#else
[numthreads(1, 1, 1)]
void computeMain()
{
    // Two runtime-dependent values distinguish the positive control from a folded constant.
    for (uint i = 0; i < 2; ++i)
    {
        Graph graph = makeGraph(float3(inputs[0], inputs[1], inputs[2]), float(inputs[i]));
        outputs[4 * i] = uint(dot(exp2(-graph.stack.payload.absorption), float3(8)));
        outputs[4 * i + 1] = uint(graph.stack.normals[0].z);
        outputs[4 * i + 2] = uint(graph.stack.normals[1].z);
        outputs[4 * i + 3] = uint(graph.stack.layers[0].x);
    }
}
#endif
